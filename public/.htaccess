# LIMITLESS – limitlesstudio.com (Hostinger / LiteSpeed)

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Immer HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # www → ohne www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  # Kurze Adressen für die rechtlichen Seiten
  RewriteRule ^impressum/?$ /impressum.html [L]
  RewriteRule ^datenschutz/?$ /datenschutz.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Fotogramme, Audio, Bibliotheken und Vite-Assets ändern sich nie (neue Dateien = neue Namen)
  <If "%{REQUEST_URI} =~ m#^/(frames|audio|vendor|assets)/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Seite, CSS und JS des Prototyps: immer frisch prüfen, damit Updates sofort sichtbar sind
  <If "%{REQUEST_URI} =~ m#^/(js|css)/|\.html$|^/$#">
    Header set Cache-Control "no-cache"
  </If>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType audio/mp4 .m4a
  AddType audio/ogg .ogg
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
