# ---------------------------------------------------------------
# Variables PÚBLICAS (prefijo VITE_): acaban en el código del navegador.
# NUNCA pongas aquí contraseñas, tokens ni URLs secretas.
# ---------------------------------------------------------------

# Dominio definitivo, sin barra final. Activa canonical, og:url y og:image absolutas.
VITE_SITE_URL=

# Destino del formulario (si no hay ninguno, queda en modo demostración):
#  - Recomendado: el endpoint propio incluido en el proyecto (Vercel/Netlify).
VITE_LEAD_ENDPOINT=
#  - Alternativa sin servidor: abre la app de correo del visitante.
VITE_CONTACT_EMAIL=

# Datos de contacto visibles en la sección Kontakt (se ocultan si están vacíos).
VITE_CONTACT_PHONE=
VITE_WHATSAPP_URL=
# Enlace de reserva para «15-Minuten-Gespräch buchen» (Calendly, Cal.com…).
VITE_BOOKING_URL=

# Impressum y Datenschutz (obligatorios en Suiza antes de publicar).
VITE_LEGAL_URL=
VITE_PRIVACY_URL=

# ---------------------------------------------------------------
# Variables PRIVADAS del servidor (solo en el panel de Vercel/Netlify).
# Las usa /api/lead para reenviar el lead a n8n / CRM.
# ---------------------------------------------------------------
LEAD_FORWARD_URL=
LEAD_FORWARD_SECRET=
ALLOWED_ORIGIN=
