# Valores públicos para la build de producción (Hostinger). Sin secretos.
VITE_SITE_URL=https://limitlesstudio.com

# Lanzamiento oficial (15-11-2026): Google puede indexar la web.
VITE_ALLOW_INDEXING=true

# Formulario: abre la app de correo del visitante con la solicitud dirigida a este email.
# También se muestra como dato de contacto en la sección Kontakt.
VITE_CONTACT_EMAIL=digitalmarketing@limitlesstudio.com
